{
  "app_id": "schema-advisor",
  "version": "0.2.0",
  "audience": "public",
  "metadata": {
    "display_name": "Schema Advisor",
    "description": "Review LastDB app schemas and recommend keys for the queries your app needs.",
    "homepage_url": "https://github.com/EdgeVector/schema-advisor"
  },
  "schemas": [],
  "run": {
    "runtime": "command",
    "entrypoint": "dist/schema-advisor"
  },
  "install": {
    "prepare": [
      {"argv": ["python3", "scripts/install.py"], "timeout_s": 120}
    ],
    "links": [
      {"source": "dist/schema-advisor", "command": "schema-advisor"}
    ],
    "probe": [
      {"argv": ["dist/schema-advisor", "--version"], "timeout_s": 10},
      {"argv": ["dist/schema-advisor", "recommend", "examples/issue.json", "--queries", "examples/issue-queries.json"], "timeout_s": 10}
    ]
  }
}
